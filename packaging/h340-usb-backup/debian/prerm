#!/bin/sh
set -e

case "$1" in
	remove|upgrade|deconfigure)
		# A normal stop ends a running copy cleanly and unmounts the device.
		if systemctl is-active --quiet h340-usb-backup 2>/dev/null; then
			systemctl stop h340-usb-backup || true
		fi
	;;
	failed-upgrade)
	;;
	*)
		echo "prerm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

exit 0
