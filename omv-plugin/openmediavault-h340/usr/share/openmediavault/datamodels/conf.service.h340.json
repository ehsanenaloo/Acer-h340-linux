{
	"type": "config",
	"id": "conf.service.h340",
	"title": "H340 USB Backup",
	"queryinfo": {
		"xpath": ".//services/h340",
		"iterable": false
	},
	"properties": {
		"enable": {
			"type": "boolean",
			"default": false
		},
		"sharedfolderref": {
			"type": "string",
			"oneOf": [
				{
					"type": "string",
					"format": "uuidv4"
				},
				{
					"type": "string",
					"maxLength": 0
				}
			],
			"default": ""
		},
		"reldirpath": {
			"type": "string",
			"maxLength": 255,
			"default": "USB-Backups"
		},
		"reservemib": {
			"type": "integer",
			"minimum": 0,
			"maximum": 10485760,
			"default": 5120
		},
		"label": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_-]{1,32}$",
			"default": "usb"
		},
		"excludes": {
			"type": "string",
			"maxLength": 4096,
			"default": "System Volume Information\n$RECYCLE.BIN\nlost+found\n.Trash-*"
		},
		"ledenable": {
			"type": "boolean",
			"default": false
		}
	}
}
